# The repo root holds only what the site serves: the HTML screens, ios-*
# shared files, demo-mode.js, fonts/, icons/, manifest, 5k.csv and
# sentences.json. Docs, notes, SQL and scripts go in .claude/ (allowed at the
# bottom of this file). Anything else below never gets committed.

# Notes, docs and scripts
*.md
*.sql
*.py
*.pyc
*.sh
__pycache__/
scripts/
supabase/
nouns_list.txt

# Old data and assets no screen uses any more
img/
vocab.csv
verbs.csv
prepositions.csv
adjadv.csv

# Local secrets (never commit)
supbase password.txt
*.env
.env*

# OS clutter
.DS_Store

# Extra project files live in .claude/ and ARE committed (docs, SQL, scripts)
!.claude/
!.claude/**
.claude/settings.local.json
